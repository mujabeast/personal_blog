---
import { navigation } from '@/data/navigation';
import { path } from '@/utils/paths';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '@/config';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={path('/')} title={`${siteConfig.title} home`}>
      <span class="brand-mark" aria-hidden="true">MYI</span>
      <span>{siteConfig.shortTitle}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {navigation.map((item) => (
        <a href={path(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation">
        <span class="sr-only">Open menu</span>
        <span aria-hidden="true">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-navigation" hidden>
    <div class="mobile-panel-inner shell">
      <div class="mobile-label mono">Navigation / index</div>
      <nav aria-label="Mobile">
        {navigation.map((item, index) => (
          <a href={path(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
          </a>
        ))}
      </nav>
      <p>Press Escape to close.</p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  const panel = header?.querySelector<HTMLElement>('.mobile-panel');
  const links = panel?.querySelectorAll<HTMLAnchorElement>('a');
  let previousFocus: HTMLElement | null = null;

  function setOpen(open: boolean) {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    button.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    button.querySelector('[aria-hidden]')!.textContent = open ? 'Close' : 'Menu';
    panel.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    if (open) {
      previousFocus = document.activeElement as HTMLElement;
      links?.[0]?.focus();
    } else if (previousFocus && document.activeElement !== button) {
      previousFocus.focus();
    }
  }

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  links?.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (!panel || panel.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false);
      button?.focus();
    }
    if (event.key === 'Tab') {
      const focusable = [button, ...(links ?? [])].filter(Boolean) as HTMLElement[];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: var(--header);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 35px;
    color: #10201f;
    background: var(--signal);
    place-items: center;
  }

  .desktop-nav {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.6rem);
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .desktop-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -0.75rem;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
  }

  .menu-button {
    display: none;
    min-width: 64px;
    border: 1px solid var(--line);
    background: transparent;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .mobile-panel {
    position: fixed;
    inset: 72px 0 0;
    height: calc(100dvh - 72px);
    background: var(--paper);
  }

  .mobile-panel-inner {
    padding-block: 2.5rem;
  }

  .mobile-panel nav {
    margin: 1.2rem 0 2rem;
    border-top: 1px solid var(--line);
  }

  .mobile-panel nav a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: clamp(1.5rem, 8vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .mobile-panel nav span {
    padding-top: 0.55rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0;
  }

  .mobile-panel p {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: block;
    }
  }
</style>
