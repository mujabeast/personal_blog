---
import { navigation } from '@/data/navigation';
import { path } from '@/utils/paths';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '@/config';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href={path('/')} aria-label={`${siteConfig.title} home`} title={`${siteConfig.title} home`}>
      <span class="brand-mark" aria-hidden="true">MYI</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {navigation.map((item) => (
        <a href={path(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="search-link" href={path('/search/')}>Search</a>
      <ThemeToggle />
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-navigation">
        <span class="sr-only">Open menu</span>
        <span aria-hidden="true">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-navigation" hidden>
    <nav class="shell" aria-label="Mobile">
      {navigation.map((item) => (
        <a href={path(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={path('/search/')}>Search</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  const panel = header?.querySelector<HTMLElement>('.mobile-panel');
  const links = panel?.querySelectorAll<HTMLAnchorElement>('a');
  let previousFocus: HTMLElement | null = null;

  function setOpen(open: boolean) {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    button.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    button.querySelector('[aria-hidden]')!.textContent = open ? 'Close' : 'Menu';
    panel.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    if (open) {
      previousFocus = document.activeElement as HTMLElement;
      links?.[0]?.focus();
    } else if (previousFocus && document.activeElement !== button) {
      previousFocus.focus();
    }
  }

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  links?.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (!panel || panel.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false);
      button?.focus();
    }
    if (event.key === 'Tab') {
      const focusable = [button, ...(links ?? [])].filter(Boolean) as HTMLElement[];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    gap: 1.5rem;
    align-items: center;
  }

  .brand {
    display: block;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 32px;
    border: 1px solid var(--line-strong);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.68rem;
    place-items: center;
  }

  .desktop-nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .desktop-nav a {
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    border-bottom-color: var(--green);
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .search-link {
    padding: 0.4rem 0.65rem;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .search-link:hover {
    color: var(--green);
  }

  .menu-button {
    display: none;
    min-height: 36px;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    font-size: 0.78rem;
  }

  .mobile-panel {
    position: fixed;
    inset: 65px 0 0;
    padding-top: 1rem;
    background: var(--paper);
  }

  .mobile-panel nav {
    display: grid;
  }

  .mobile-panel a {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
    text-decoration: none;
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current="page"] {
    color: var(--green);
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 880px) {
    .desktop-nav,
    .search-link {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .menu-button {
      display: block;
    }
  }
</style>
