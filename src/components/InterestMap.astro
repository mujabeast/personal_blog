---
import { getCollection } from 'astro:content';
import { interestTopics, type InterestTopicId } from '@/data/interests';
import { projects } from '@/data/projects';
import { getPosts } from '@/utils/posts';
import { path, postPath, projectPath } from '@/utils/paths';

interface Point {
  x: number;
  y: number;
}

interface GraphEntry {
  id: string;
  title: string;
  shortTitle: string;
  href: string;
  type: 'Post' | 'Project' | 'Page';
  graphTopics: InterestTopicId[];
}

const posts = await getPosts();
const pages = await getCollection('pages', ({ data }) => data.graphTopics.length > 0);

function shorten(title: string, limit = 24): string {
  return title.length <= limit ? title : `${title.slice(0, limit - 1).trimEnd()}…`;
}

function safeId(value: string): string {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const entries: GraphEntry[] = [
  ...posts
    .filter(({ data }) => data.graphTopics.length > 0)
    .map((post) => ({
      id: `post-${safeId(post.id)}`,
      title: post.data.title,
      shortTitle: shorten(post.data.title),
      href: postPath(post.id),
      type: 'Post' as const,
      graphTopics: [...post.data.graphTopics]
    })),
  ...projects
    .filter((project) => project.graphTopics?.length)
    .map((project) => ({
      id: `project-${project.number.toLowerCase()}`,
      title: project.title,
      shortTitle: shorten(project.title),
      href: projectPath(project.slug),
      type: 'Project' as const,
      graphTopics: [...(project.graphTopics ?? [])]
    })),
  ...pages.map((page) => ({
    id: `page-${safeId(page.id)}`,
    title: page.data.title,
    shortTitle: shorten(page.data.title),
    href: path(`/${page.id}/`),
    type: 'Page' as const,
    graphTopics: [...page.data.graphTopics]
  }))
];

const canvas = { width: 760, height: 500, centre: { x: 380, y: 250 } };

function topicPosition(index: number, count: number): Point {
  const angle = -Math.PI * 5 / 6 + index * (Math.PI * 2 / count);
  return {
    x: canvas.centre.x + Math.cos(angle) * 225,
    y: canvas.centre.y + Math.sin(angle) * 170
  };
}

function leafPosition(topic: Point, index: number, count: number): Point {
  const dx = topic.x - canvas.centre.x;
  const dy = topic.y - canvas.centre.y;
  const side = Math.abs(dx) > Math.abs(dy)
    ? dx < 0 ? 'left' : 'right'
    : dy < 0 ? 'top' : 'bottom';
  const lane = Math.floor(index / 4);
  const laneIndex = index % 4;
  const laneCount = Math.min(4, count - lane * 4);
  const offset = laneIndex - (laneCount - 1) / 2;

  if (side === 'top' || side === 'bottom') {
    return {
      x: canvas.centre.x + offset * 150,
      y: side === 'top' ? 34 + lane * 58 : canvas.height - 34 - lane * 58
    };
  }

  return {
    x: side === 'left' ? 78 + lane * 158 : canvas.width - 78 - lane * 158,
    y: canvas.centre.y + offset * 92
  };
}

const topics = interestTopics.map((topic, topicIndex) => {
  const topicEntries = entries.filter((entry) => entry.graphTopics.includes(topic.id));
  const position = topicPosition(topicIndex, interestTopics.length);
  return {
    ...topic,
    position,
    entries: topicEntries.map((entry, index) => ({
      ...entry,
      nodeId: `${topic.id}-${entry.id}`,
      position: leafPosition(position, index, topicEntries.length)
    }))
  };
});
---

<div class="graph-backdrop" data-graph-backdrop hidden></div>
<section class="interest-map" data-interest-map aria-labelledby="interest-map-title">
  <div class="map-heading">
    <h2 id="interest-map-title">My Current Interests!</h2>
    <div class="map-actions">
      <button type="button" data-graph-reset>Reset</button>
      <button
        class="expand-button"
        type="button"
        data-graph-expand
        aria-label="Expand graph"
        aria-expanded="false"
        title="Expand graph"
      >
        <svg class="expand-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
        </svg>
        <svg class="collapse-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5"></path>
        </svg>
      </button>
    </div>
    <p>Drag nodes · scroll to zoom · select topics for branches.</p>
  </div>

  <div class="graph-viewport">
    <svg
      class="map-canvas"
      viewBox={`0 0 ${canvas.width} ${canvas.height}`}
      role="img"
      aria-labelledby="map-title map-description"
      data-graph
    >
      <title id="map-title">Interactive current interests knowledge graph</title>
      <desc id="map-description">
        Six topics connect only to the central current interests node. Selecting a topic reveals linked posts, projects, or pages. Every node can be dragged and the graph can be zoomed.
      </desc>

      <g class="edges" aria-hidden="true">
        {topics.map((topic) => (
          <line
            class="edge topic-edge"
            data-source="current"
            data-target={`topic-${topic.id}`}
            x1={canvas.centre.x}
            y1={canvas.centre.y}
            x2={topic.position.x}
            y2={topic.position.y}
          />
        ))}
        {topics.flatMap((topic) =>
          topic.entries.map((entry) => (
            <line
              class="edge branch-edge is-hidden"
              data-topic={topic.id}
              data-source={`topic-${topic.id}`}
              data-target={entry.nodeId}
              x1={topic.position.x}
              y1={topic.position.y}
              x2={entry.position.x}
              y2={entry.position.y}
            />
          ))
        )}
      </g>

      <g
        class="graph-node current-node"
        data-node-id="current"
        data-home-x={canvas.centre.x}
        data-home-y={canvas.centre.y}
        transform={`translate(${canvas.centre.x} ${canvas.centre.y})`}
      >
        <a href={path('/now/')} aria-label="Open the current interests page">
          <rect x="-95" y="-24" width="190" height="48" rx="5" />
          <text class="node-label" y="5">Interests</text>
        </a>
      </g>

      {topics.map((topic) => (
        <g
          class="graph-node topic-node"
          data-node-id={`topic-${topic.id}`}
          data-topic-node={topic.id}
          data-home-x={topic.position.x}
          data-home-y={topic.position.y}
          transform={`translate(${topic.position.x} ${topic.position.y})`}
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label={`${topic.label}: ${topic.entries.length} ${topic.entries.length === 1 ? 'branch' : 'branches'}`}
        >
          <title>{`Select ${topic.label} to ${topic.entries.length ? 'show its branches' : 'focus the topic'}`}</title>
          <rect x="-99" y="-24" width="198" height="48" rx="5" />
          <text class="node-label" y="5">{topic.label} ({topic.entries.length})</text>
        </g>
      ))}

      {topics.flatMap((topic) =>
        topic.entries.map((entry) => (
          <g
            class="graph-node content-node is-hidden"
            data-node-id={entry.nodeId}
            data-topic={topic.id}
            data-home-x={entry.position.x}
            data-home-y={entry.position.y}
            transform={`translate(${entry.position.x} ${entry.position.y})`}
            aria-hidden="true"
          >
            <a href={entry.href} tabindex="-1" aria-label={`Open ${entry.type.toLowerCase()}: ${entry.title}`}>
              <title>{entry.title}</title>
              <rect x="-95" y="-28" width="190" height="56" rx="5" />
              <text class="node-label" y="-3">{entry.shortTitle}</text>
              <text class="node-meta" y="17">{entry.type}</text>
            </a>
          </g>
        ))
      )}
    </svg>
  </div>

  <noscript>
    <p class="no-script">Enable JavaScript to move the graph and reveal content branches.</p>
  </noscript>
</section>

<script>
  interface GraphNode {
    element: SVGGElement;
    x: number;
    y: number;
    homeX: number;
    homeY: number;
    vx: number;
    vy: number;
    dragging: boolean;
  }

  document.querySelectorAll<HTMLElement>('[data-interest-map]').forEach((map) => {
    const svg = map.querySelector<SVGSVGElement>('[data-graph]');
    const resetButton = map.querySelector<HTMLButtonElement>('[data-graph-reset]');
    const expandButton = map.querySelector<HTMLButtonElement>('[data-graph-expand]');
    const backdrop = map.previousElementSibling instanceof HTMLElement
      && map.previousElementSibling.matches('[data-graph-backdrop]')
      ? map.previousElementSibling
      : null;
    if (!svg || !resetButton || !expandButton || !backdrop) return;
    const graph = svg;
    const expandControl = expandButton;
    const overlay = backdrop;

    const width = graph.viewBox.baseVal.width;
    const height = graph.viewBox.baseVal.height;
    const baseCamera = { x: 0, y: 0, width, height };
    let camera = { ...baseCamera };
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodeElements = [...graph.querySelectorAll<SVGGElement>('[data-node-id]')];
    const nodes = new Map<string, GraphNode>(
      nodeElements.map((element) => {
        const homeX = Number(element.dataset.homeX);
        const homeY = Number(element.dataset.homeY);
        return [
          element.dataset.nodeId ?? '',
          { element, x: homeX, y: homeY, homeX, homeY, vx: 0, vy: 0, dragging: false }
        ];
      })
    );
    const edges = [...graph.querySelectorAll<SVGLineElement>('.edge')];
    let activeTopic = '';
    let animationFrame = 0;
    let energy = 0;
    let draggedNode: GraphNode | undefined;
    let pointerOffset = { x: 0, y: 0 };
    let pointerStart = { x: 0, y: 0 };
    let movedDuringPointer = false;
    let suppressClick = false;
    let expanded = false;

    function visibleNodes(): GraphNode[] {
      return [...nodes.values()].filter(({ element }) => !element.classList.contains('is-hidden'));
    }

    function updateNode(node: GraphNode): void {
      node.element.setAttribute('transform', `translate(${node.x} ${node.y})`);
    }

    function updateEdges(): void {
      edges.forEach((edge) => {
        if (edge.classList.contains('is-hidden')) return;
        const source = nodes.get(edge.dataset.source ?? '');
        const target = nodes.get(edge.dataset.target ?? '');
        if (!source || !target) return;
        edge.setAttribute('x1', String(source.x));
        edge.setAttribute('y1', String(source.y));
        edge.setAttribute('x2', String(target.x));
        edge.setAttribute('y2', String(target.y));
      });
    }

    function updateCamera(): void {
      graph.setAttribute('viewBox', `${camera.x} ${camera.y} ${camera.width} ${camera.height}`);
    }

    function graphPoint(event: PointerEvent): DOMPoint {
      const matrix = graph.getScreenCTM();
      if (!matrix) return new DOMPoint(event.clientX, event.clientY);
      return new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
    }

    function runPhysics(): void {
      animationFrame = 0;
      if (reducedMotion || energy < 0.015) return;
      const visible = visibleNodes();
      const forces = new Map(visible.map((node) => [node, { x: 0, y: 0 }]));

      for (let firstIndex = 0; firstIndex < visible.length; firstIndex += 1) {
        for (let secondIndex = firstIndex + 1; secondIndex < visible.length; secondIndex += 1) {
          const first = visible[firstIndex]!;
          const second = visible[secondIndex]!;
          const dx = second.x - first.x || 0.01;
          const dy = second.y - first.y || 0.01;
          const distanceSquared = Math.max(dx * dx + dy * dy, 900);
          const distance = Math.sqrt(distanceSquared);
          const strength = 3300 / distanceSquared;
          const forceX = (dx / distance) * strength;
          const forceY = (dy / distance) * strength;
          forces.get(first)!.x -= forceX;
          forces.get(first)!.y -= forceY;
          forces.get(second)!.x += forceX;
          forces.get(second)!.y += forceY;
        }
      }

      edges.forEach((edge) => {
        if (edge.classList.contains('is-hidden')) return;
        const source = nodes.get(edge.dataset.source ?? '');
        const target = nodes.get(edge.dataset.target ?? '');
        if (!source || !target || !forces.has(source) || !forces.has(target)) return;
        const dx = target.x - source.x || 0.01;
        const dy = target.y - source.y || 0.01;
        const distance = Math.sqrt(dx * dx + dy * dy);
        const desired = edge.classList.contains('branch-edge') ? 135 : 205;
        const strength = (distance - desired) * 0.0035;
        const forceX = (dx / distance) * strength;
        const forceY = (dy / distance) * strength;
        forces.get(source)!.x += forceX;
        forces.get(source)!.y += forceY;
        forces.get(target)!.x -= forceX;
        forces.get(target)!.y -= forceY;
      });

      visible.forEach((node) => {
        if (node.dragging) return;
        const force = forces.get(node)!;
        force.x += (width / 2 - node.x) * 0.00035;
        force.y += (height / 2 - node.y) * 0.00035;
        node.vx = (node.vx + force.x * energy) * 0.88;
        node.vy = (node.vy + force.y * energy) * 0.88;
        node.x += node.vx;
        node.y += node.vy;
        updateNode(node);
      });

      updateEdges();
      energy *= 0.972;
      animationFrame = window.requestAnimationFrame(runPhysics);
    }

    function wakeGraph(amount = 0.75): void {
      energy = Math.max(energy, amount);
      if (!animationFrame) animationFrame = window.requestAnimationFrame(runPhysics);
    }

    function setTopic(topicId: string): void {
      const shouldOpen = activeTopic !== topicId;
      activeTopic = shouldOpen ? topicId : '';

      graph.querySelectorAll<SVGGElement>('[data-topic-node]').forEach((topicNode) => {
        const open = topicNode.dataset.topicNode === activeTopic;
        topicNode.setAttribute('aria-expanded', String(open));
        topicNode.classList.toggle('is-active', open);
      });

      graph.querySelectorAll<SVGGElement>('.content-node').forEach((contentNode) => {
        const open = contentNode.dataset.topic === activeTopic;
        contentNode.classList.toggle('is-hidden', !open);
        contentNode.setAttribute('aria-hidden', String(!open));
        contentNode.querySelector('a')?.setAttribute('tabindex', open ? '0' : '-1');
      });

      graph.querySelectorAll<SVGLineElement>('.branch-edge').forEach((edge) => {
        edge.classList.toggle('is-hidden', edge.dataset.topic !== activeTopic);
      });

      updateEdges();
      wakeGraph(0.9);
    }

    nodeElements.forEach((element) => {
      const node = nodes.get(element.dataset.nodeId ?? '');
      if (!node) return;

      element.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const point = graphPoint(event);
        draggedNode = node;
        node.dragging = true;
        pointerOffset = { x: node.x - point.x, y: node.y - point.y };
        pointerStart = { x: point.x, y: point.y };
        movedDuringPointer = false;
        element.classList.add('is-dragging');
        wakeGraph(0.9);
      });

      element.addEventListener('pointermove', (event) => {
        if (draggedNode !== node) return;
        const point = graphPoint(event);
        if (!movedDuringPointer && Math.hypot(point.x - pointerStart.x, point.y - pointerStart.y) <= 3) return;
        const nextX = point.x + pointerOffset.x;
        const nextY = point.y + pointerOffset.y;
        if (!movedDuringPointer) {
          movedDuringPointer = true;
          if (!element.hasPointerCapture(event.pointerId)) element.setPointerCapture(event.pointerId);
        }
        node.x = nextX;
        node.y = nextY;
        node.vx = 0;
        node.vy = 0;
        updateNode(node);
        updateEdges();
        if (movedDuringPointer) event.preventDefault();
      });

      const finishPointer = (event: PointerEvent) => {
        if (draggedNode !== node) return;
        suppressClick = movedDuringPointer;
        if (suppressClick) {
          window.setTimeout(() => {
            suppressClick = false;
          }, 0);
        }
        node.dragging = false;
        draggedNode = undefined;
        element.classList.remove('is-dragging');
        if (element.hasPointerCapture(event.pointerId)) element.releasePointerCapture(event.pointerId);
        wakeGraph(0.65);
      };

      element.addEventListener('pointerup', finishPointer);
      element.addEventListener('pointercancel', finishPointer);
      element.addEventListener('click', (event) => {
        if (suppressClick) {
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
          return;
        }
        const topicId = element.dataset.topicNode;
        if (topicId) {
          event.preventDefault();
          setTopic(topicId);
        }
      });

      if (element.dataset.topicNode) {
        element.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          setTopic(element.dataset.topicNode ?? '');
        });
      }
    });

    graph.addEventListener('wheel', (event) => {
      event.preventDefault();
      const bounds = graph.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      const pointerX = camera.x + ((event.clientX - bounds.left) / bounds.width) * camera.width;
      const pointerY = camera.y + ((event.clientY - bounds.top) / bounds.height) * camera.height;
      const zoomFactor = Math.exp(event.deltaY * 0.0012);
      const nextWidth = Math.min(width * 2.4, Math.max(width * 0.48, camera.width * zoomFactor));
      const nextHeight = nextWidth * (height / width);
      const ratioX = (pointerX - camera.x) / camera.width;
      const ratioY = (pointerY - camera.y) / camera.height;
      camera = {
        x: pointerX - ratioX * nextWidth,
        y: pointerY - ratioY * nextHeight,
        width: nextWidth,
        height: nextHeight
      };
      updateCamera();
    }, { passive: false });

    function fitVisibleNodes(): void {
      const visible = visibleNodes();
      if (!visible.length) return;
      const paddingX = 115;
      const paddingY = 65;
      const minX = Math.min(...visible.map((node) => node.x)) - paddingX;
      const maxX = Math.max(...visible.map((node) => node.x)) + paddingX;
      const minY = Math.min(...visible.map((node) => node.y)) - paddingY;
      const maxY = Math.max(...visible.map((node) => node.y)) + paddingY;
      const contentWidth = maxX - minX;
      const contentHeight = maxY - minY;
      const aspectRatio = width / height;
      const nextWidth = Math.max(contentWidth, contentHeight * aspectRatio);
      const nextHeight = nextWidth / aspectRatio;
      camera = {
        x: (minX + maxX) / 2 - nextWidth / 2,
        y: (minY + maxY) / 2 - nextHeight / 2,
        width: nextWidth,
        height: nextHeight
      };
      updateCamera();
    }

    function setExpanded(nextExpanded: boolean): void {
      expanded = nextExpanded;
      map.classList.toggle('is-expanded', expanded);
      overlay.hidden = !expanded;
      document.body.classList.toggle('graph-expanded', expanded);
      expandControl.setAttribute('aria-expanded', String(expanded));
      const label = expanded ? 'Collapse graph' : 'Expand graph';
      expandControl.setAttribute('aria-label', label);
      expandControl.setAttribute('title', label);
      if (expanded) {
        window.requestAnimationFrame(() => {
          fitVisibleNodes();
          expandControl.focus();
        });
      }
    }

    expandControl.addEventListener('click', () => setExpanded(!expanded));
    overlay.addEventListener('click', () => setExpanded(false));
    document.addEventListener('keydown', (event) => {
      if (expanded && event.key === 'Escape') {
        event.preventDefault();
        setExpanded(false);
      }
    });

    resetButton.addEventListener('click', () => {
      activeTopic = '';
      camera = { ...baseCamera };
      updateCamera();
      nodes.forEach((node) => {
        node.x = node.homeX;
        node.y = node.homeY;
        node.vx = 0;
        node.vy = 0;
        updateNode(node);
      });
      graph.querySelectorAll<SVGGElement>('[data-topic-node]').forEach((topicNode) => {
        topicNode.setAttribute('aria-expanded', 'false');
        topicNode.classList.remove('is-active');
      });
      graph.querySelectorAll<SVGGElement>('.content-node').forEach((contentNode) => {
        contentNode.classList.add('is-hidden');
        contentNode.setAttribute('aria-hidden', 'true');
        contentNode.querySelector('a')?.setAttribute('tabindex', '-1');
      });
      graph.querySelectorAll<SVGLineElement>('.branch-edge').forEach((edge) => edge.classList.add('is-hidden'));
      updateEdges();
      wakeGraph(0.55);
    });

    updateEdges();
    wakeGraph(0.45);
  });
</script>

<style>
  .interest-map {
    min-width: 0;
    width: min(100%, 440px);
    margin-left: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    justify-self: end;
  }

  .graph-backdrop {
    position: fixed;
    z-index: 199;
    inset: 0;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  .graph-backdrop[hidden] {
    display: none;
  }

  .map-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.7rem 0.85rem 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .map-heading h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .map-heading p {
    grid-column: 1 / -1;
    margin: -0.45rem 0 0;
    color: var(--muted);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .map-actions {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    white-space: nowrap;
  }

  .map-actions button {
    color: var(--muted);
    font: inherit;
    font-size: 0.74rem;
  }

  .map-actions button {
    padding: 0;
    border: 0;
    background: transparent;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .map-actions .expand-button {
    display: grid;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line);
    text-decoration: none;
    place-items: center;
  }

  .expand-button svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .collapse-icon,
  .interest-map.is-expanded .expand-icon {
    display: none;
  }

  .interest-map.is-expanded .collapse-icon {
    display: block;
  }

  .map-actions button:hover {
    color: var(--green);
  }

  .graph-viewport {
    overflow: hidden;
    overscroll-behavior: contain;
  }

  .map-canvas {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
    cursor: zoom-in;
  }

  .edge {
    stroke: var(--line-strong);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .branch-edge {
    stroke: var(--green);
    stroke-opacity: 0.72;
  }

  .is-hidden {
    display: none;
  }

  .graph-node {
    cursor: grab;
    touch-action: none;
  }

  .graph-node.is-dragging {
    cursor: grabbing;
  }

  .graph-node rect {
    fill: var(--paper);
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .graph-node text {
    fill: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
    pointer-events: none;
    user-select: none;
  }

  .graph-node .node-meta {
    fill: var(--ink);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    opacity: 0.72;
