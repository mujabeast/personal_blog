---
import type { Post } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { categoryLabels } from '@/config';
import { formatDate, isoDate } from '@/utils/dates';
import { readingTimeFor } from '@/utils/posts';

interface Props {
  post: Post;
  index?: number;
}

const { post } = Astro.props;
---

<li
  class="post-card"
  data-post-card
  data-title={post.data.title.toLowerCase()}
  data-description={post.data.description.toLowerCase()}
  data-category={post.data.category}
  data-tags={post.data.tags.join(',')}
  data-date={post.data.publishedDate.toISOString()}
>
  <div class="post-main">
    <h3><a href={postPath(post.id)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <time datetime={isoDate(post.data.publishedDate)}>{formatDate(post.data.publishedDate)}</time>
      <a href={path(`/categories/${post.data.category}/`)}>{categoryLabels[post.data.category]}</a>
      <span>{readingTimeFor(post)}</span>
      {post.data.draft && <span class="draft">Draft</span>}
    </div>
  </div>
</li>

<style>
  .post-card {
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.35rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .post-meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .post-main h3 {
    max-width: 42ch;
    margin: 0 0 0.35rem;
    font-size: 1.28rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .post-main h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-main h3 a:hover {
    color: var(--accent-dark);
  }

  .post-main p {
    max-width: 67ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .draft {
    padding: 0 0.35rem;
    color: var(--ink);
    background: var(--signal);
  }

</style>
