---
import type { Post } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { categoryLabels } from '@/config';
import { formatDate, isoDate } from '@/utils/dates';
import { readingTimeFor } from '@/utils/posts';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<li
  class="post-card"
  data-post-card
  data-title={post.data.title.toLowerCase()}
  data-description={post.data.description.toLowerCase()}
  data-category={post.data.category}
  data-tags={post.data.tags.join(',')}
  data-date={post.data.publishedDate.toISOString()}
>
  <div class="post-number mono">{String(index + 1).padStart(2, '0')}</div>
  <div class="post-main">
    <div class="post-meta mono">
      <a href={path(`/categories/${post.data.category}/`)}>{categoryLabels[post.data.category]}</a>
      <time datetime={isoDate(post.data.publishedDate)}>{formatDate(post.data.publishedDate)}</time>
      <span>{readingTimeFor(post)}</span>
      {post.data.draft && <span class="draft">Draft</span>}
    </div>
    <h3><a href={postPath(post.id)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="tags">
      {post.data.tags.slice(0, 4).map((tag) => <a class="tag" href={path(`/tags/${tag}/`)}>#{tag}</a>)}
    </div>
  </div>
  <a class="post-arrow" href={postPath(post.id)} aria-label={`Read ${post.data.title}`}>↗</a>
</li>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.2rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .post-number {
    padding-top: 0.25rem;
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
  }

  .post-meta a {
    color: var(--accent-dark);
  }

  .post-main h3 {
    max-width: 23ch;
    margin: 0.45rem 0 0.4rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .post-main h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-main h3 a:hover {
    color: var(--accent-dark);
  }

  .post-main p {
    max-width: 67ch;
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-arrow {
    color: var(--accent);
    font-size: 1.35rem;
    text-decoration: none;
  }

  .draft {
    padding: 0 0.35rem;
    color: #10201f;
    background: var(--signal);
  }

  @media (max-width: 620px) {
    .post-card {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .post-arrow {
      display: none;
    }
  }
</style>
