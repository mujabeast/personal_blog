---
import type { Project } from '@/data/projects';
import { projectPath } from '@/utils/paths';

interface Props { project: Project; }
const { project } = Astro.props;
const projectId = `project-${project.number.toLowerCase()}`;
---

<li class="project-card" id={projectId}>
  <a class="project-card-link" href={projectPath(project.slug)} aria-label={`Open project: ${project.title}`}>
    <div class="project-top">
      <span class="mono">{project.number}</span>
      <span class:list={['status', project.status.toLowerCase().replace(' ', '-')]}>{project.status}</span>
    </div>
    <div>
      {project.period && <p class="mono">{project.period}</p>}
      <h3>{project.title}</h3>
      <p class="description">{project.description}</p>
      <ul class="details">
        {project.details.map((detail) => <li>{detail}</li>)}
      </ul>
    </div>
    <div class="project-side">
      <div class="project-tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      <span class="project-cta">Open project <span aria-hidden="true">→</span></span>
    </div>
  </a>
</li>

<style>
  .project-card {
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }

  .project-card-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) minmax(140px, 0.35fr);
    gap: 1.5rem;
    margin-inline: -1rem;
    padding: 1.4rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .project-card-link:hover {
    background: var(--paper-raised);
    box-shadow: inset 2px 0 var(--green);
  }

  .project-card-link:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: -2px;
  }

  .project-top {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .status {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    width: fit-content;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  h3 {
    max-width: 24ch;
    margin: 0.25rem 0 0.65rem;
    color: var(--ink);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .description {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 0.98rem;
  }

  .details {
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .project-side {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .project-cta {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .project-card-link:hover .project-cta,
  .project-card-link:focus-visible .project-cta {
    color: var(--green);
  }

  @media (max-width: 780px) {
    .project-card-link {
      grid-template-columns: 1fr;
    }

    .project-top {
      flex-direction: row;
      justify-content: space-between;
    }

    .project-side {
      align-items: flex-start;
    }

    .project-tags {
      justify-content: flex-start;
    }
  }
</style>
