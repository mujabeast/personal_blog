---
import type { Project } from '@/data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---

<li class="project-card">
  <div class="project-top">
    <span class="mono">{project.number}</span>
    <span class:list={['status', project.status.toLowerCase().replace(' ', '-')]}>
      {project.status}
    </span>
  </div>
  <div>
    <p class="mono">{project.period}</p>
    <h3>{project.title}</h3>
    <p class="description">{project.description}</p>
    <ul class="details">
      {project.details.map((detail) => <li>{detail}</li>)}
    </ul>
  </div>
  <div class="project-tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
</li>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) minmax(140px, 0.35fr);
    gap: 1.5rem;
    margin-bottom: 1rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .project-top {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .status {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    width: fit-content;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  h3 {
    max-width: 24ch;
    margin: 0.25rem 0 0.65rem;
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .description {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 0.98rem;
  }

  .details {
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.4rem;
  }

  @media (max-width: 780px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-top {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
