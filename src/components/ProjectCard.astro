---
import type { Project } from '@/data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---

<li class="project-card">
  <div class="project-top">
    <span class="mono">{project.number}</span>
    <span class:list={['status', project.status.toLowerCase().replace(' ', '-')]}>
      <span aria-hidden="true"></span>{project.status}
    </span>
  </div>
  <div>
    <p class="mono">{project.period}</p>
    <h3>{project.title}</h3>
    <p class="description">{project.description}</p>
    <ul class="details">
      {project.details.map((detail) => <li>{detail}</li>)}
    </ul>
  </div>
  <div class="project-tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
</li>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) minmax(160px, 0.45fr);
    gap: clamp(1.2rem, 4vw, 3rem);
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .project-top {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .status {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    width: fit-content;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .status span {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--accent);
  }

  .status.completed span {
    background: var(--muted);
  }

  h3 {
    max-width: 24ch;
    margin: 0.25rem 0 0.65rem;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .description {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.08rem;
  }

  .details {
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.4rem;
  }

  @media (max-width: 780px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-top {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
