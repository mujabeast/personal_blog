<button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
  <span class="light-icon" aria-hidden="true">Dark</span>
  <span class="dark-icon" aria-hidden="true">Light</span>
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateLabel() {
    buttons.forEach((button) => {
      button.setAttribute('aria-label', `Switch to ${currentTheme() === 'dark' ? 'light' : 'dark'} mode`);
    });
  }

  updateLabel();
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      updateLabel();
    });
  });
</script>

<style>
  .theme-toggle {
    min-height: 36px;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    font-size: 0.78rem;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .dark-icon,
  :global([data-theme="dark"]) .light-icon {
    display: none;
  }

  :global([data-theme="dark"]) .dark-icon {
    display: inline;
  }
</style>
