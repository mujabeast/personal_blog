<button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
  <svg class="theme-icon light-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.3 15.7A8.5 8.5 0 0 1 8.3 3.7 8.5 8.5 0 1 0 20.3 15.7Z"></path>
  </svg>
  <svg class="theme-icon dark-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
  </svg>
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateLabel() {
    buttons.forEach((button) => {
      const label = `Switch to ${currentTheme() === 'dark' ? 'light' : 'dark'} mode`;
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    });
  }

  updateLabel();
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      updateLabel();
    });
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    place-items: center;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .dark-icon,
  :global([data-theme="dark"]) .light-icon {
    display: none;
  }

  :global([data-theme="dark"]) .dark-icon {
    display: block;
  }

  .theme-icon {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
</style>
