---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; eyebrow?: string; }
const { title, description, eyebrow = 'Index' } = Astro.props;
const showEyebrow = eyebrow.trim().toLocaleLowerCase() !== title.trim().toLocaleLowerCase();
---

<BaseLayout {title} {description}>
  <header class="page-head">
    <div class="shell">
      {showEyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </header>
  <slot />
</BaseLayout>
