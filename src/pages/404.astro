---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { path } from '@/utils/paths';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found shell">
    <span class="eyebrow">Error / 404</span>
    <h1>Page not found</h1>
    <p>The link may be old, the note may still be a draft, or the address may have been typed incorrectly.</p>
    <div class="button-row">
      <a class="button primary" href={path('/')}>Return home</a>
      <a class="button" href={path('/blog/')}>Browse writing</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 12vw, 10rem);
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .not-found > p {
    max-width: 56ch;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.2rem;
  }
</style>
