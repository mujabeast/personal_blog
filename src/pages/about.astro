---
import { getEntry, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { path } from '@/utils/paths';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(page);
---

<PageLayout title={page.data.title} description={page.data.description} eyebrow="About">
  <section class="about-grid shell">
    <div class="profile-index">
      <figure class="about-photo">
        <img src={path('/images/profile.jpg')} alt="Mujahid Y.I at a cybersecurity event" width="960" height="1280" />
      </figure>
      <dl>
        <div><dt>Based</dt><dd>Singapore</dd></div>
        <div><dt>Studying</dt><dd>Information Engineering & Media</dd></div>
        <div><dt>University</dt><dd>Nanyang Technological University</dd></div>
        <div><dt>Direction</dt><dd>Systems, security, teaching</dd></div>
      </dl>
      <SocialLinks />
      <a class="button" href={path('/journey/')}>Read the long version →</a>
    </div>
    <div class="prose"><Content /></div>
  </section>
</PageLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(250px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .profile-index {
    align-self: start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
  }

  .about-photo {
    margin: 0;
  }

  .about-photo img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  dl {
    margin: 1rem 0 1.5rem;
  }

  dl div {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  dd {
    margin: 0.1rem 0 0;
  }

  .profile-index .button {
    margin-top: 1.5rem;
  }

  :global(.about-grid .prose > *) {
    margin-inline: 0;
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

  }
</style>
