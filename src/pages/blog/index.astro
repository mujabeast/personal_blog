---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Search from '@/components/Search.astro';
import { getPosts } from '@/utils/posts';
import { categoryLabels } from '@/config';
import { path } from '@/utils/paths';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<PageLayout
  title="Blog"
  description="Technical notes, project records, and reflections. Search the blog or browse by category."
  eyebrow="Blog"
>
  <section class="archive shell">
    <nav class="category-strip" aria-label="Blog categories">
      {Object.entries(categoryLabels).map(([key, label]) => (
        <a href={path(`/categories/${key}/`)}>{label}</a>
      ))}
    </nav>
    <Search {tags} />
    <noscript><p class="noscript-note">Filters require JavaScript. All published posts remain visible below.</p></noscript>
    <ul class="post-list" data-filter-list>
      {posts.map((post, index) => <PostCard {post} {index} />)}
    </ul>
  </section>
</PageLayout>

<style>
  .archive {
    padding-block: 3rem 6rem;
  }

  .category-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-strip a {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .category-strip a:hover {
    color: var(--accent-dark);
    background: var(--paper-raised);
  }

  .noscript-note {
    padding: 1rem;
    border: 1px solid var(--line);
  }

</style>
