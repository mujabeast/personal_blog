---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import InterestMap from '@/components/InterestMap.astro';
import { getPosts, readingTimeFor } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { formatDate, isoDate } from '@/utils/dates';

const posts = await getPosts();
const latestPost = posts[0];
---

<BaseLayout>
  <div class="shell home">
    <div class="home-opening">
      <section class="home-intro" aria-labelledby="home-title">
        <div class="intro-label">
          <span class="monogram" aria-hidden="true">MYI</span>
          <span class="eyebrow">About</span>
        </div>

        <h1 id="home-title">Mujahid Yang Iskandar</h1>
        <p>
          Hi! I’m Mujahid, a Year 2 Information Engineering and Media student at NTU.
        </p>
        <p>
          I’m quite passionate about anything cybersecurity-related, and I currently spend most of my time learning
          topics like web security, reverse engineering and, more recently, IoT and hardware security. The OSCP grind
          comes and goes depending on my workload, but uhh, it’s coming!
        </p>
        <p>
          I’m also part of NTU Sentinels, my school’s cybersecurity club. I help plan stuff, teach stuff, and get to
          meet a lot of cool people along the way (defcon sg!!) I also create fun CTF challenges :D
        </p>
        <p>
          This website is where I share my cybersec journey, my notes, projects and things I learn along the way ~
        </p>

        <div class="home-links">
          <a href={path('/blog/')}>Read my notes</a>
          <a href={path('/projects/')}>View my projects</a>
          <a href={path('/about/')}>More about me</a>
        </div>
        <SocialLinks />
      </section>

      <InterestMap />
    </div>

    {latestPost && (
      <section class="latest" aria-labelledby="latest-heading">
        <div class="latest-heading">
          <h2 id="latest-heading">Latest note</h2>
          <a href={path('/blog/')}>Blog</a>
        </div>
        <article>
          <h3><a href={postPath(latestPost.id)}>{latestPost.data.title}</a></h3>
          <p>{latestPost.data.description}</p>
          <div class="latest-meta">
            <time datetime={isoDate(latestPost.data.publishedDate)}>{formatDate(latestPost.data.publishedDate)}</time>
            <span>{readingTimeFor(latestPost)}</span>
          </div>
        </article>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 1120px;
  }

  .home-opening {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(3rem, 5vw, 4.5rem);
    min-height: min(680px, calc(78svh - 64px));
    align-items: center;
  }

  .home-intro {
    max-width: 620px;
    padding-block: 4.5rem;
  }

  .intro-label {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin-bottom: 1.4rem;
  }

  .monogram {
    display: grid;
    width: 44px;
    height: 40px;
    border: 1px solid var(--line-strong);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 700;
    place-items: center;
  }

  .home-intro h1 {
    margin: 0 0 0.8rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }

  .home-intro > p {
    max-width: 63ch;
    margin: 0.65rem 0;
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin: 1.35rem 0 1rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .home-links a {
    color: var(--green);
  }

  :global(.home-intro .social-links) {
    font-family: var(--sans);
  }

  .latest {
    max-width: 820px;
    padding: 2.5rem 0 5rem;
    border-top: 1px solid var(--line);
  }

  .latest-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.3rem;
  }

  .latest-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .latest-heading > a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .latest article {
    padding-left: 1.1rem;
    border-left: 2px solid var(--green);
  }

  .latest h3 {
    margin: 0 0 0.4rem;
    font-size: 1.22rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .latest h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .latest h3 a:hover {
    color: var(--green);
  }

  .latest article > p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .latest-meta {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 920px) {
    .home-opening {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: auto;
    }

    .home-intro {
      padding: 4rem 0 2.5rem;
    }

    :global(.home-opening .interest-map) {
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 620px) {
    .home-intro h1 {
      font-size: 1.55rem;
    }

    .latest {
      padding-bottom: 4rem;
    }
  }
</style>
