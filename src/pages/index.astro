---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPosts, readingTimeFor } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { formatDate, isoDate } from '@/utils/dates';

const posts = await getPosts();
const latestPost = posts[0];
---

<BaseLayout>
  <div class="shell home">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="intro-label">
        <span class="monogram" aria-hidden="true">MYI</span>
        <span class="eyebrow">About</span>
      </div>

      <h1 id="home-title">Mujahid Y.I</h1>
      <p class="lead">
        I’m an Information Engineering and Media student at NTU. My current work and study cover cybersecurity,
        computer systems, CTF development, IoT, and hardware security.
      </p>
      <p>
        I also contribute to technical education and community programmes through NTU Sentinels. This site contains
        my technical notes and public project records.
      </p>

      <div class="home-links">
        <a href={path('/blog/')}>Read my notes</a>
        <a href={path('/projects/')}>View my projects</a>
        <a href={path('/about/')}>More about me</a>
      </div>
      <SocialLinks />
    </section>

    {latestPost && (
      <section class="latest" aria-labelledby="latest-heading">
        <div class="latest-heading">
          <h2 id="latest-heading">Latest note</h2>
          <a href={path('/blog/')}>Writing archive</a>
        </div>
        <article>
          <h3><a href={postPath(latestPost.id)}>{latestPost.data.title}</a></h3>
          <p>{latestPost.data.description}</p>
          <div class="latest-meta">
            <time datetime={isoDate(latestPost.data.publishedDate)}>{formatDate(latestPost.data.publishedDate)}</time>
            <span>{readingTimeFor(latestPost)}</span>
          </div>
        </article>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 1120px;
  }

  .home-intro {
    display: grid;
    min-height: min(680px, calc(78svh - 64px));
    max-width: 720px;
    align-content: center;
    padding-block: 4.5rem;
  }

  .intro-label {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin-bottom: 1.4rem;
  }

  .monogram {
    display: grid;
    width: 44px;
    height: 40px;
    border: 1px solid var(--line-strong);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 700;
    place-items: center;
  }

  .home-intro h1 {
    margin: 0 0 0.8rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }

  .home-intro > p {
    max-width: 63ch;
    margin: 0.65rem 0;
    color: var(--muted);
  }

  .home-intro .lead {
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin: 1.35rem 0 1rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .home-links a {
    color: var(--green);
  }

  :global(.home-intro .social-links) {
    font-family: var(--sans);
  }

  .latest {
    max-width: 820px;
    padding: 2.5rem 0 5rem;
    border-top: 1px solid var(--line);
  }

  .latest-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.3rem;
  }

  .latest-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .latest-heading > a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .latest article {
    padding-left: 1.1rem;
    border-left: 2px solid var(--green);
  }

  .latest h3 {
    margin: 0 0 0.4rem;
    font-size: 1.22rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .latest h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .latest h3 a:hover {
    color: var(--green);
  }

  .latest article > p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .latest-meta {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 620px) {
    .home-intro {
      min-height: auto;
      padding-block: 4rem;
    }

    .home-intro h1 {
      font-size: 1.55rem;
    }

    .latest {
      padding-bottom: 4rem;
    }
  }
</style>
