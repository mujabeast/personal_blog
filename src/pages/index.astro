---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPosts } from '@/utils/posts';
import { path } from '@/utils/paths';
import { currentFocus } from '@/data/focus';
import { projects } from '@/data/projects';

const posts = await getPosts();
const recentPosts = posts.slice(0, 4);
---

<BaseLayout>
  <div class="shell home">
    <section class="intro-grid">
      <div class="intro">
        <p class="eyebrow">Personal notes</p>
        <h1>Notes and project work</h1>
        <p class="intro-copy">
          Technical writing and public project records covering cybersecurity, computer systems, CTF development,
          IoT, and hardware security.
        </p>
        <nav class="intro-links" aria-label="Featured sections">
          <a href={path('/blog/')}>Browse writing</a>
          <a href={path('/projects/')}>View projects</a>
          <a href={path('/now/')}>Current work</a>
        </nav>
      </div>

      <aside class="about-summary" aria-labelledby="about-name">
        <div class="monogram" aria-hidden="true">MYI</div>
        <div>
          <p class="eyebrow">About</p>
          <h2 id="about-name">Mujahid Y.I</h2>
        </div>
        <p>
          Information Engineering and Media student at NTU, working across security, systems, challenge development,
          and technical education.
        </p>
        <SocialLinks />
        <a class="about-link" href={path('/about/')}>More about me</a>
      </aside>
    </section>

    <div class="work-grid">
      <section class="home-section" aria-labelledby="recent-writing">
        <div class="home-section-heading">
          <h2 id="recent-writing">Recent writing</h2>
          <a href={path('/blog/')}>View all</a>
        </div>
        {recentPosts.length > 0 ? (
          <ul class="post-list">
            {recentPosts.map((post, index) => <PostCard {post} {index} />)}
          </ul>
        ) : (
          <p class="empty-state">No published articles yet.</p>
        )}
      </section>

      <section class="home-section" aria-labelledby="selected-projects">
        <div class="home-section-heading">
          <h2 id="selected-projects">Selected projects</h2>
          <a href={path('/projects/')}>View all</a>
        </div>
        <ul class="compact-projects">
          {projects.filter((project) => project.featured).slice(0, 3).map((project) => (
            <li>
              <div class="project-meta">
                <span>{project.number}</span>
                <span>{project.status}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="areas" aria-labelledby="current-areas">
      <div class="home-section-heading">
        <h2 id="current-areas">Current areas</h2>
        <a href={path('/now/')}>Details</a>
      </div>
      <ul>
        {currentFocus.map((item) => (
          <li>
            <span>{item.code}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: 3rem 4rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2.5rem, 7vw, 6rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .intro {
    align-self: center;
  }

  .intro h1 {
    margin: 0.35rem 0 0.7rem;
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-top: 1.25rem;
    font-size: 0.9rem;
  }

  .intro-links a {
    color: var(--green);
  }

  .about-summary {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 0.9rem 1rem;
    padding: 1.25rem 0 0;
    border-top: 2px solid var(--green);
  }

  .monogram {
    display: grid;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-strong);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    place-items: center;
  }

  .about-summary h2 {
    margin: 0.2rem 0 0;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .about-summary > p:not(.eyebrow) {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.about-summary .social-links) {
    grid-column: 1 / -1;
    font-family: var(--sans);
  }

  .about-link {
    grid-column: 1 / -1;
    width: fit-content;
    font-size: 0.86rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-top: 3rem;
  }

  .home-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }

  .home-section-heading h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .home-section-heading a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .compact-projects {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  .compact-projects li {
    padding: 1.35rem 0;
    border-top: 1px solid var(--line);
  }

  .project-meta {
    display: flex;
    gap: 1rem;
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.67rem;
    text-transform: uppercase;
  }

  .compact-projects h3 {
    margin: 0.4rem 0 0.3rem;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .compact-projects p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .areas {
    margin-top: 3.5rem;
  }

  .areas ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .areas li {
    padding: 1.1rem 1.25rem 1.2rem 0;
  }

  .areas li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .areas li > span {
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.67rem;
  }

  .areas h3 {
    margin: 0.45rem 0 0.25rem;
    font-size: 0.98rem;
    font-weight: 600;
  }

  .areas p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .intro-grid,
    .work-grid {
      grid-template-columns: 1fr;
    }

    .areas ul {
      grid-template-columns: 1fr 1fr;
    }

    .areas li:nth-child(3) {
      border-left: 0;
    }

    .areas li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .home {
      padding-block: 2rem 3rem;
    }

    .areas ul {
      grid-template-columns: 1fr;
    }

    .areas li + li {
      padding-left: 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
