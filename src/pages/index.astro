---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Timeline from '@/components/Timeline.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPosts, readingTimeFor } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { formatDate, isoDate } from '@/utils/dates';
import { currentFocus } from '@/data/focus';
import { projects } from '@/data/projects';

const posts = await getPosts();
const primaryPost = posts.find((post) => post.data.featured) ?? posts[0];
---

<BaseLayout>
  <section class="work-overview">
    <div class="shell overview-grid">
      <div class="overview-main">
        <span class="eyebrow">Cybersecurity notes and projects</span>
        <h1>Writing and project records on security, systems, and CTF development.</h1>
        <p class="overview-copy">
          This site contains technical notes, project documentation, CTF material, and reflections on workshops and community work.
        </p>
        <div class="button-row">
          <a class="button primary" href={path('/blog/')}>Browse writing</a>
          <a class="button" href={path('/projects/')}>View projects</a>
        </div>

        {primaryPost ? (
          <article class="latest-entry">
            <div class="entry-meta mono">
              <span>Latest article</span>
              <time datetime={isoDate(primaryPost.data.publishedDate)}>{formatDate(primaryPost.data.publishedDate)}</time>
              <span>{readingTimeFor(primaryPost)}</span>
            </div>
            <h2><a href={postPath(primaryPost.id)}>{primaryPost.data.title}</a></h2>
            <p>{primaryPost.data.description}</p>
            <a class="text-link" href={postPath(primaryPost.id)}>Read article <span aria-hidden="true">→</span></a>
          </article>
        ) : (
          <div class="empty-state"><p>No published articles yet.</p></div>
        )}
      </div>

      <aside class="profile-summary" aria-labelledby="profile-name">
        <div class="profile-mark" aria-hidden="true">MYI</div>
        <p class="mono">About</p>
        <h2 id="profile-name">Mujahid Y.I</h2>
        <p>
          Information Engineering and Media student at NTU. My current work covers web and API security, Linux, CTF challenge development, IoT, and hardware security.
        </p>
        <p>
          I also contribute to cybersecurity education and community programmes through NTU Sentinels.
        </p>
        <SocialLinks />
        <nav class="profile-links" aria-label="Profile pages">
          <a href={path('/about/')}>About</a>
          <a href={path('/journey/')}>Learning journey</a>
          <a href={path('/now/')}>Current work</a>
        </nav>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">Projects</span><h2>Selected work</h2></div>
        <a href={path('/projects/')}>All projects →</a>
      </div>
      <ul class="project-list">
        {projects.filter((project) => project.featured).slice(0, 3).map((project) => <ProjectCard {project} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">Current work</span><h2>Topics in progress</h2></div>
        <a href={path('/now/')}>Updated notes →</a>
      </div>
      <div class="focus-list">
        {currentFocus.map((item) => (
          <article>
            <span class="mono">{item.code}</span>
            <div><h3>{item.title}</h3><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="eyebrow">Background</span><h2>Selected timeline</h2></div>
        <a href={path('/journey/')}>Full journey →</a>
      </div>
      <Timeline limit={7} />
    </div>
  </section>
</BaseLayout>

<style>
  .work-overview {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 310px);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .overview-main h1 {
    max-width: 18ch;
    margin: 0.55rem 0 1.2rem;
    font-size: clamp(2.25rem, 5vw, 4.6rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .overview-copy {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.22rem);
    line-height: 1.65;
  }

  .overview-main .button-row {
    margin-top: 1.75rem;
  }

  .latest-entry {
    max-width: 800px;
    margin-top: clamp(3.5rem, 8vw, 6.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .entry-meta span:first-child {
    color: var(--accent-dark);
  }

  .latest-entry h2 {
    max-width: 24ch;
    margin: 0.55rem 0 0.65rem;
    font-size: clamp(1.55rem, 3.2vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .latest-entry h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .latest-entry h2 a:hover {
    color: var(--accent-dark);
  }

  .latest-entry > p {
    max-width: 65ch;
    color: var(--muted);
  }

  .text-link {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .profile-summary {
    padding: 1.25rem 0 0;
    border-top: 2px solid var(--accent);
  }

  .profile-mark {
    display: grid;
    width: 48px;
    height: 48px;
    margin-bottom: 1.5rem;
    color: #10201f;
    background: var(--signal);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    place-items: center;
  }

  .profile-summary h2 {
    margin: 0.25rem 0 0.75rem;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
  }

  .profile-summary > p:not(.mono) {
    color: var(--muted);
    font-size: 0.92rem;
  }

  :global(.profile-summary .social-links) {
    margin: 1.25rem 0;
  }

  .profile-links {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .profile-links a {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .profile-links a:hover {
    color: var(--accent-dark);
  }

  .focus-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line-strong);
  }

  .focus-list article {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 1.5rem 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .focus-list article:nth-child(odd) {
    margin-right: 1.5rem;
    border-right: 1px solid var(--line);
  }

  .focus-list h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
  }

  .focus-list p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .overview-grid {
      grid-template-columns: 1fr;
    }

    .profile-summary {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 1.25rem;
    }

    .profile-summary > :not(.profile-mark) {
      grid-column: 2;
    }

    .profile-mark {
      grid-row: 1 / span 4;
    }

    .profile-links {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 620px) {
    .focus-list {
      grid-template-columns: 1fr;
    }

    .focus-list article:nth-child(odd) {
      margin-right: 0;
      border-right: 0;
    }

    .profile-summary {
      display: block;
    }
  }
</style>
