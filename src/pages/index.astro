---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Timeline from '@/components/Timeline.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPosts } from '@/utils/posts';
import { path } from '@/utils/paths';
import { currentFocus } from '@/data/focus';
import { projects } from '@/data/projects';
import { siteConfig } from '@/config';

const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const latest = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">Singapore / systems / security</span>
        <h1>Mujahid<br />Iskandar<span class="signal-dot">.</span></h1>
        <p class="role">{siteConfig.subtitle}</p>
        <p class="hero-summary">I am an Information Engineering and Media student at NTU exploring cybersecurity, computer systems, hardware security and CTF development. I document what I learn, build and sometimes need to rethink.</p>
        <div class="button-row">
          <a class="button primary" href={path('/journey/')}>Read my journey →</a>
          <a class="button" href={path('/blog/')}>View my writing</a>
          <a class="button" href={path('/projects/')}>View projects</a>
        </div>
        <SocialLinks class="hero-socials" />
      </div>
      <aside class="hero-index">
        <p class="mono">Current bearing / 2026</p>
        <div class="bearing" aria-hidden="true">
          <span>LEARN</span><span>BUILD</span><span>TEACH</span>
          <div class="crosshair"></div>
        </div>
        <p>This is a field notebook, not a claim that the work is finished.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Live threads</span><h2>Current focus</h2></div><a href={path('/now/')}>Full /now page →</a></div>
      <div class="focus-grid">
        {currentFocus.map((item) => (
          <article><span class="mono">{item.code}</span><h3>{item.title}</h3><p>{item.detail}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Selected notes</span><h2>Featured writing</h2></div><a href={path('/blog/')}>Browse all writing →</a></div>
      {featured.length > 0 ? <ul class="post-list">{featured.map((post, index) => <PostCard {post} {index} />)}</ul> : (
        <div class="empty-state"><p>No featured posts yet. The latest writing is listed below.</p></div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Build log</span><h2>Selected projects</h2></div><a href={path('/projects/')}>Project index →</a></div>
      <ul class="project-list">{projects.filter((project) => project.featured).slice(0, 3).map((project) => <ProjectCard {project} />)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Change over time</span><h2>A short timeline</h2></div><a href={path('/journey/')}>Read the full narrative →</a></div>
      <Timeline limit={7} />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">Archive feed</span><h2>Latest writing</h2></div><a href={path('/rss.xml')}>Subscribe via RSS →</a></div>
      <ul class="post-list">{latest.map((post, index) => <PostCard {post} {index} />)}</ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    min-height: calc(100svh - 72px);
    align-items: center;
    padding: clamp(4rem, 9vw, 8rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(240px, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
  }

  .role {
    max-width: 760px;
    margin: 0 0 1.25rem;
    font-size: clamp(1.15rem, 2.5vw, 1.65rem);
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .signal-dot {
    color: var(--accent);
  }

  .hero .button-row {
    margin-top: 2rem;
  }

  :global(.hero-socials) {
    margin-top: 1.25rem;
  }

  .hero-index {
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .bearing {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    margin: 1rem 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-items: center;
  }

  .bearing::before,
  .bearing::after {
    position: absolute;
    width: 70%;
    height: 70%;
    border: 1px solid var(--line);
    border-radius: 50%;
    content: "";
  }

  .bearing::after {
    width: 35%;
    height: 35%;
  }

  .bearing span {
    position: absolute;
    z-index: 1;
    padding: 0.1rem 0.3rem;
    color: var(--muted);
    background: var(--paper-raised);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .bearing span:nth-child(1) { top: 8%; }
  .bearing span:nth-child(2) { right: 1%; bottom: 25%; }
  .bearing span:nth-child(3) { bottom: 8%; left: 14%; }

  .crosshair {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--signal) 25%, transparent);
  }

  .hero-index > p:last-child {
    color: var(--muted);
    font-family: var(--serif);
    font-size: 0.95rem;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
  }

  .focus-grid article {
    min-height: 240px;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .focus-grid article:last-child {
    border-right: 0;
  }

  .focus-grid h3 {
    margin: 3.5rem 0 0.5rem;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .focus-grid p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-index {
      display: none;
    }

    .focus-grid {
      grid-template-columns: 1fr 1fr;
    }

    .focus-grid article:nth-child(2) {
      border-right: 0;
    }

    .focus-grid article:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }

    .focus-grid article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .focus-grid h3 {
      margin-top: 1.5rem;
    }
  }
</style>
