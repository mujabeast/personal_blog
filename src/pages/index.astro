---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { getPosts } from '@/utils/posts';
import { postPath, path } from '@/utils/paths';
import { currentFocus } from '@/data/focus';
import { projects } from '@/data/projects';
import { categoryLabels } from '@/config';

const posts = await getPosts();
const recentPosts = posts.slice(0, 4);
const recentTags = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 10);
---

<BaseLayout>
  <div class="shell home">
    <header class="content-bar">
      <span>Home</span>
      <a href={path('/search/')} aria-label="Search the site">Search</a>
    </header>

    <div class="home-grid">
      <div class="home-main">
        <section class="intro" aria-labelledby="intro-title">
          <p class="eyebrow">About</p>
          <h1 id="intro-title">Security notes, project records, and things I am learning.</h1>
          <p>
            I’m Mujahid Y.I, an Information Engineering and Media student at NTU. I’m interested in cybersecurity,
            computer systems, CTF development, IoT, and hardware security.
          </p>
          <p>
            This site is where I keep technical notes, document public project work, and write about workshops and
            community programmes I contribute to through NTU Sentinels.
          </p>
          <div class="intro-links">
            <a href={path('/about/')}>More about me</a>
            <a href={path('/now/')}>What I’m working on</a>
            <a href={path('/journey/')}>Learning journey</a>
          </div>
          <SocialLinks />
        </section>

        <section class="home-section" aria-labelledby="recent-writing">
          <div class="home-section-heading">
            <h2 id="recent-writing">Recent writing</h2>
            <a href={path('/blog/')}>View all</a>
          </div>
          {recentPosts.length > 0 ? (
            <ul class="post-list">
              {recentPosts.map((post, index) => <PostCard {post} {index} />)}
            </ul>
          ) : (
            <p class="empty-state">No published articles yet.</p>
          )}
        </section>

        <section class="home-section" aria-labelledby="selected-projects">
          <div class="home-section-heading">
            <h2 id="selected-projects">Selected projects</h2>
            <a href={path('/projects/')}>View all</a>
          </div>
          <ul class="compact-projects">
            {projects.filter((project) => project.featured).slice(0, 3).map((project) => (
              <li>
                <div>
                  <span>{project.number}</span>
                  <span>{project.status}</span>
                </div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="home-rail" aria-label="Site overview">
        <section>
          <h2>Current areas</h2>
          <ul class="rail-list">
            {currentFocus.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Recently updated</h2>
          <ul class="link-list">
            {posts.slice(0, 5).map((post) => (
              <li><a href={postPath(post.id)}>{post.data.title}</a></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Browse</h2>
          <div class="category-links">
            {Object.entries(categoryLabels).map(([key, label]) => (
              <a href={path(`/categories/${key}/`)}>{label}</a>
            ))}
          </div>
          {recentTags.length > 0 && (
            <div class="rail-tags">
              {recentTags.map((tag) => <a class="tag" href={path(`/tags/${tag}/`)}>#{tag}</a>)}
            </div>
          )}
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: 3rem;
  }

  .content-bar {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .content-bar a {
    min-width: 9rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .content-bar a:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 2.25rem;
    padding-top: 1.5rem;
  }

  .intro {
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .intro h1 {
    max-width: 34ch;
    margin: 0.35rem 0 0.8rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .intro > p:not(.eyebrow) {
    max-width: 65ch;
    margin: 0.65rem 0;
    color: var(--muted);
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.1rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  :global(.intro .social-links) {
    font-family: var(--sans);
    font-size: 0.86rem;
  }

  .home-section {
    padding-top: 2.75rem;
  }

  .home-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .home-section-heading h2,
  .home-rail h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .home-section-heading a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .compact-projects,
  .rail-list,
  .link-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compact-projects li {
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
  }

  .compact-projects li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .compact-projects li > div {
    display: flex;
    gap: 1rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .compact-projects h3 {
    margin: 0.35rem 0 0.25rem;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .compact-projects p {
    max-width: 68ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .home-rail {
    padding-top: 0.25rem;
  }

  .home-rail section {
    margin-bottom: 2.6rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .home-rail h2 {
    margin-bottom: 0.85rem;
    color: var(--muted);
  }

  .rail-list li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
  }

  .rail-list strong,
  .rail-list span {
    display: block;
  }

  .rail-list strong {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .rail-list span {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .link-list li {
    margin: 0.55rem 0;
  }

  .link-list a {
    display: block;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-list a:hover {
    color: var(--ink);
  }

  .category-links {
    display: grid;
    gap: 0.35rem;
  }

  .category-links a {
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .category-links a:hover {
    color: var(--ink);
  }

  .rail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.2rem;
  }

  @media (max-width: 1120px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .home-rail {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 700px) {
    .home-rail {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .content-bar a {
      min-width: 7rem;
    }

    .intro {
      padding: 1.2rem;
    }
  }
</style>
