---
import { getEntry, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatDate, isoDate } from '@/utils/dates';
const page = await getEntry('pages', 'now');
if (!page) throw new Error('Missing src/content/pages/now.md');
const { Content } = await render(page);
---

<PageLayout title={page.data.title} description={page.data.description} eyebrow="Now">
  <section class="now-shell narrow">
    {page.data.lastUpdated && (
      <div class="updated mono">Last updated <time datetime={isoDate(page.data.lastUpdated)}>{formatDate(page.data.lastUpdated)}</time></div>
    )}
    <div class="prose"><Content /></div>
  </section>
</PageLayout>

<style>
  .now-shell {
    padding-block: 2.75rem 5rem;
  }

  .updated {
    width: fit-content;
    margin-bottom: 2rem;
    padding: 0 0 0.45rem;
    border-bottom: 1px solid var(--green);
    color: var(--ink);
    background: transparent;
    font-size: 0.75rem;
  }
</style>
