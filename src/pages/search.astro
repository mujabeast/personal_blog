---
import { getPosts } from '@/utils/posts';
import PageLayout from '@/layouts/PageLayout.astro';
import Search from '@/components/Search.astro';
import PostCard from '@/components/PostCard.astro';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<PageLayout title="Search" description="Search the local, build-time writing index. Nothing is sent to an external service." eyebrow="Archive / search">
  <section class="section shell">
    <Search {tags} />
    <ul class="post-list" data-filter-list>{posts.map((post, index) => <PostCard {post} {index} />)}</ul>
  </section>
</PageLayout>
