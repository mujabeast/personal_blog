---
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }
  }));
}
const { tag, posts } = Astro.props;
---

<PageLayout title={`#${tag}`} description={`Notes connected to ${tag.replaceAll('-', ' ')}.`} eyebrow="Tag">
  <section class="section shell">
    <ul class="post-list">{posts.map((post, index) => <PostCard {post} {index} />)}</ul>
  </section>
</PageLayout>
